# =============================================================================
# Nesq Bot - local development environment
# =============================================================================
# cp .env.example .env  &&  docker compose up -d
#
# Everything in this file has a working default. A fresh clone with this file
# copied verbatim comes up with: mock desktops, mock model responses, dev auth.
# No Azure account, no secrets, no bot-desktop image required.
#
# Legend
#   [required-prod]  must be set to a real value before production
#   [optional]       safe to leave blank; the app degrades gracefully
#   [compose]        consumed by docker-compose.yml itself, not by the apps
#
# Var names mirror the pydantic Settings fields in
#   apps/api/app/config.py   and   apps/worker/worker/config.py
# (lowercase field name -> UPPERCASE env var). Keep them in sync.
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# development | staging | production. `production` disables /auth/dev-login
# and the X-Nesq-Dev header.
NESQ_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# [required-prod] Signing key for the API's own JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-change-me

# Comma-separated exact origins.
#   1420  = Tauri/Vite dev server
#   8081  = Expo dev server (Metro, and Expo web)
#   19006 = legacy Expo web port, harmless to keep
#
# Native iOS/Android requests are not subject to CORS at all, but Expo *web*
# is, and so is the Tauri dev server. Testing on a physical device over the LAN
# means the phone loads the app from your machine's LAN address, so add that
# origin too - e.g. http://192.168.1.42:8081 - or the browser blocks the API
# call while the native build works fine, which is a confusing pair of symptoms.
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006


# -----------------------------------------------------------------------------
# Data stores
# -----------------------------------------------------------------------------
# NOTE: these values are for running the API/worker ON THE HOST. Inside compose
# the service definitions override them with postgres:5432 / redis:6379.
DATABASE_URL=postgresql+asyncpg://nesq:nesq@localhost:5432/nesqbot
REDIS_URL=redis://localhost:6379/0

# [compose] Credentials the postgres container is created with. Changing these
# after the first `up` requires `make reset-db` (the volume is initialised once).
POSTGRES_USER=nesq
POSTGRES_PASSWORD=nesq
POSTGRES_DB=nesqbot

# [compose] Host port publishing. Change if something already owns the port.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8080
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8088
REDIS_MAXMEMORY=256mb


# -----------------------------------------------------------------------------
# Temporal
# -----------------------------------------------------------------------------
# Host value again; compose overrides to temporal:7233.
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nesq-bot

# The API treats Temporal as optional: /routines/{id}/run falls back to inline
# execution when a client cannot be obtained inside this budget. Keep it short
# so a missing Temporal never stalls a request.
TEMPORAL_CONNECT_TIMEOUT_SECONDS=5
TEMPORAL_RPC_TIMEOUT_SECONDS=15

# Worker-side reconnect loop (Temporal is usually still booting on a cold
# `compose up`). 0 attempts = retry forever.
WORKER_CONNECT_MAX_ATTEMPTS=0
WORKER_CONNECT_INITIAL_BACKOFF_SECONDS=1
WORKER_CONNECT_MAX_BACKOFF_SECONDS=30
WORKER_RECONCILE_SCHEDULES=true
WORKER_SCHEDULE_WORKFLOW=RoutineWorkflow


# -----------------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------------
# Every outbound call the API makes - model, connectors, MCP servers.
# docs/API.md pins 60 s with 3 tenacity attempts on
# APIConnectionError / RateLimitError / 5xx.
REQUEST_TIMEOUT_SECONDS=60
# Desktop sidecar calls are interactive; fail before a UI request gives up.
SIDECAR_TIMEOUT_SECONDS=30
# Redis is on the health-check path, so a slow connect must not hang /health.
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Worker outbound HTTP (mirrors the fields in worker/config.py).
WORKER_IDENTITY=
WORKER_HTTP_TIMEOUT_SECONDS=60
WORKER_HTTP_CONNECT_TIMEOUT_SECONDS=10
WORKER_DESKTOP_READY_TIMEOUT_SECONDS=300
WORKER_DESKTOP_POLL_INTERVAL_SECONDS=3
WORKER_APPROVAL_TIMEOUT_SECONDS=86400
WORKER_APPROVAL_POLL_INTERVAL_SECONDS=10
WORKER_STEP_TIMEOUT_SECONDS=900
WORKER_MESSAGE_TIMEOUT_SECONDS=300
WORKER_MAX_CONCURRENT_ACTIVITIES=20
WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=40
WORKER_GRACEFUL_SHUTDOWN_SECONDS=20


# -----------------------------------------------------------------------------
# Worker -> API authentication
# -----------------------------------------------------------------------------
# In development the worker calls the API with `X-Nesq-Dev: 1`.
API_INTERNAL_URL=http://localhost:8080
API_DEV_HEADER=true
# [required-prod] Bearer token the worker presents instead of the dev header.
# API_DEV_HEADER is ignored once this is set, and refused when NESQ_ENV=production.
WORKER_API_TOKEN=

# Liveness marker the worker refreshes; read by its own container HEALTHCHECK
# (`python -m worker.main --healthcheck`). The image already defaults this to
# /app/run/worker.health - only override it if you change the image.
WORKER_HEALTH_FILE=/app/run/worker.health
WORKER_HEALTH_INTERVAL_SECONDS=15
WORKER_HEALTH_MAX_AGE_SECONDS=90


# -----------------------------------------------------------------------------
# Microsoft Entra ID (sign-in)
# -----------------------------------------------------------------------------
# [optional locally] When blank the API accepts POST /api/auth/dev-login and
# the X-Nesq-Dev header. [required-prod] - production must use /auth/entra.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# How long the API caches the tenant's JWKS before refetching it to validate
# an id_token. Entra rotates signing keys, so this is a real ceiling on how
# stale a cached key may be, not just a performance knob.
ENTRA_JWKS_CACHE_SECONDS=3600
# Comma-separated. Entra signs with RS256; widening this list weakens
# validation, so do not add algorithms speculatively.
ENTRA_ALLOWED_ALGORITHMS=RS256

# The desktop and mobile clients read these at build time (Expo inlines any
# EXPO_PUBLIC_* var into the bundle, so never put a secret behind that prefix).
# Same values as AZURE_TENANT_ID / AZURE_CLIENT_ID; they are duplicated because
# the clients cannot read the server's environment.
EXPO_PUBLIC_ENTRA_TENANT_ID=
EXPO_PUBLIC_ENTRA_CLIENT_ID=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# One-time Entra setup for the clients - Bicep cannot do this, because app
# registrations live in Microsoft Graph rather than ARM:
#
#   1. Entra ID -> App registrations -> New registration
#        Supported account types: single tenant
#   2. Authentication -> Add a platform -> Mobile and desktop applications
#        Custom redirect URI:  nesqbot://auth
#        (The mobile Settings screen shows this string verbatim.)
#   3. Authentication -> Implicit grant -> tick "ID tokens"
#   4. Copy the Application (client) ID into AZURE_CLIENT_ID and
#      EXPO_PUBLIC_ENTRA_CLIENT_ID; the Directory (tenant) ID into the two
#      TENANT_ID vars.
#
# Equivalent CLI:
#   az ad app create --display-name "Nesq Bot" \
#     --public-client-redirect-uris "nesqbot://auth" \
#     --enable-id-token-issuance true


# -----------------------------------------------------------------------------
# Expo / EAS (mobile build)
# -----------------------------------------------------------------------------
# REQUIRED for push notifications. `getExpoPushTokenAsync` cannot issue a token
# without an EAS project id, so approval notifications silently do nothing
# until this is set. It lives in apps/mobile/app.json under
# `expo.extra.eas.projectId` - not in this file - and is written by:
#
#   npx eas init            # inside apps/mobile, once, after `eas login`
#
# Verify with: node -p "require('./apps/mobile/app.json').expo.extra.eas.projectId"
# Recorded here purely so the value is discoverable alongside everything else.
EAS_PROJECT_ID=


# -----------------------------------------------------------------------------
# Azure AI Foundry / Azure OpenAI
# -----------------------------------------------------------------------------
# [optional locally] With no endpoint/key the model router returns deterministic
# mock completions and services/rag.embed() returns None (KB search falls back
# to keyword matching). [required-prod]
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Deployment names, not model names. Must match what exists in your Foundry
# resource - see infra/azure/main.bicep, which creates exactly these four, and
# apps/api/app/config.py, which defaults to exactly these strings.
# Verified available in swedencentral as GlobalStandard:
#   az cognitiveservices model list -l swedencentral
AZURE_DEPLOYMENT_NANO=gpt-5.6-luna
AZURE_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_DEPLOYMENT_REASON=gpt-5.6-sol
AZURE_DEPLOYMENT_EMBED=text-embedding-3-small


# -----------------------------------------------------------------------------
# What a desktop agent step costs
# -----------------------------------------------------------------------------
# A bot that looks at its own screen is priced in *images*, and an image is
# roughly a thousand prompt tokens whatever the model. A real 35-step LinkedIn
# run once spent a whole $5.00 daily budget in one turn, almost entirely on
# re-sending screenshots the model had already acted on.
#
# These apply to the agent loop only. GET /bots/{id}/desktop/screenshot still
# serves a full-size PNG, because docs/API.md pins png_base64 and a human
# looking at their bot's screen wants the real pixels.

# jpeg | png. JPEG q70 at 1024px wide prices at 765 prompt tokens against 1105
# for a full 1280x800 PNG - a 1.44x token saving, because the image-token
# formula refits everything into a 768px short edge before it counts tiles. The
# real win here is bytes and therefore latency: a full-screen PNG is ~1.5 MB of
# base64 per step.
AGENT_SCREENSHOT_FORMAT=jpeg
AGENT_SCREENSHOT_QUALITY=70
# Rescales, which changes the coordinate space the model clicks in.
# desktop.ScreenGeometry maps every point back onto true desktop pixels before
# it reaches the sidecar - do not set this without keeping that in mind.
AGENT_SCREENSHOT_MAX_WIDTH=1024
AGENT_SCREENSHOT_GRAYSCALE=false
# How many screenshots stay in the live conversation as *images*; older ones
# become a one-line placeholder before every model call. The single biggest
# cost lever in the product: without it a 35-step run re-sends 1+2+...+35 = 630
# images and the bill grows with the square of the step count. 2 is the current
# screen plus the one before it, which is what tells a model whether its last
# action did anything.
AGENT_SCREENSHOT_HISTORY=2

# reasoning_effort per class of call. Empty means "send none" and let the
# deployment decide. What each tier actually accepts next to function tools is
# narrower than the API reference suggests - see REASONING_EFFORTS in
# services/model_router.py.
#   step     an ordinary click on something the model can already see. "none"
#            measured 1.39s against 2.35s, same tool call. Runs on the reason
#            tier, where only "" and "none" are legal with tools.
#   opening  "should I act at all", on the mini tier, which takes the full
#            graded scale. This is where the "I'm going to start by..." bug was.
#   recover  after a failure, a frozen screen, a refusal to act, or a human
#            handing the screen back. Empty on purpose: the only place in the
#            loop where thinking has earned its latency.
AGENT_EFFORT_STEP=none
AGENT_EFFORT_OPENING=low
AGENT_EFFORT_RECOVER=

# What a bare browser_snapshot asks the sidecar for. The DOM lane's win is
# reliability, not size: a 200-element snapshot is ~3 000 text tokens while the
# same page as a 1024px JPEG is ~1 300 vision tokens, so an unbounded snapshot
# costs more than the screenshot it replaces. Measured on one Wikipedia
# article: 24 000 B unfiltered, 3 661 B viewport-only, 2 864 B at 60 elements,
# 990 B with a name_filter. The model can override all three per call, and a
# truncated snapshot always says how many elements it is not showing.
AGENT_BROWSER_SNAPSHOT_MAX_ELEMENTS=100
AGENT_BROWSER_SNAPSHOT_VIEWPORT_ONLY=true
AGENT_BROWSER_SNAPSHOT_MAX_TEXT=20


# -----------------------------------------------------------------------------
# Retrieval (memories + KB)
# -----------------------------------------------------------------------------
# Must match the vector(N) columns in apps/api/sql/init.sql. Changing it means
# a schema migration and re-embedding everything, not just a restart.
EMBEDDING_DIM=1536
# Ceiling on rows pulled before re-ranking a KB/memory search.
RAG_MAX_CANDIDATES=200


# -----------------------------------------------------------------------------
# Bot Desktop
# -----------------------------------------------------------------------------
# mock   - no containers at all; screenshots are generated placeholders (DEFAULT)
# docker - API spawns containers via the host Docker socket. Requires
#          `docker compose -f docker-compose.yml -f docker-compose.desktop-docker.yml up -d`
#          and `docker compose --profile desktop build bot-desktop` first.
# aci    - one Azure Container Instances container group per bot, on a subnet
#          delegated to Microsoft.ContainerInstance. The production path; see
#          the ACI_* block below and infra/azure/main.bicep.
# aks    - API records intent; the worker creates the pod (see
#          infra/bot-desktop/k8s/desktop-template.yaml)
BOT_DESKTOP_MODE=mock
# v0.2.0 or later for DOM browser control: the browser_* agent tools call the
# sidecar's /browser/* CDP surface, which v0.1.x does not have. Against an older
# image every one of them answers 503 browser_unavailable and the agent falls
# back to clicking pixel coordinates. In BOT_DESKTOP_MODE=mock there is no
# Chromium at all, so the browser tools answer the same 503 by design.
BOT_DESKTOP_IMAGE=nesqbot/bot-desktop:local
BOT_DESKTOP_NETWORK=nesqbot_default
BOT_DESKTOP_HOME_ROOT=./data/bot-homes
BOT_DESKTOP_STREAM_BASE=http://localhost:6901
# Reserved for docker mode. `apps/api/app/services/desktop.py` currently calls
# docker.from_env(), which reads DOCKER_HOST, so this only takes effect once
# the API lane wires it into config.py. The socket itself is mounted by
# docker-compose.desktop-docker.yml, not by this variable.
BOT_DESKTOP_DOCKER_HOST=unix:///var/run/docker.sock

# ---- BOT_DESKTOP_MODE=aci only. Every value is a main.bicep output. ----
# Nothing here is a secret: the driver authenticates as the API's user-assigned
# managed identity. Leave blank for mock/docker.
#   az deployment group show -g <rg> -n main --query properties.outputs
ACI_RESOURCE_GROUP=
ACI_SUBSCRIPTION_ID=
ACI_REGION=swedencentral
# Must be delegated to Microsoft.ContainerInstance/containerGroups, or ACI
# rejects the container group outright. No public IP is ever assigned.
ACI_SUBNET_ID=
ACI_CPU=2.0
ACI_MEMORY_GB=4.0
# Pull with a user-assigned identity holding AcrPull - never the ACR admin user.
ACI_REGISTRY_SERVER=
# Full ARM resource id of the identity, not its client id.
ACI_REGISTRY_IDENTITY=
ACI_START_TIMEOUT_SECONDS=180
# Azure Files mount for bot homes. Without a volume every stop wipes the bot's
# home directory and its logged-in browser sessions. The key itself stays in
# Key Vault under ACI_FILES_KEY_SECRET_NAME; never inline it.
ACI_FILES_ACCOUNT=
ACI_FILES_SHARE=bot-homes
ACI_FILES_KEY_SECRET_NAME=storage-account-key

# [required-prod] Shared secret the API sends as `X-Nesq-Sidecar-Token` and the
# sidecar verifies. Blank = the sidecar logs a loud warning and accepts
# unauthenticated control, which is fine on a laptop and unacceptable on a pod
# network. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
NESQ_SIDECAR_TOKEN=

# VNC password for the desktop stream. [required-prod]
VNC_PW=nesq

# [compose] Only used by the optional `bot-desktop` compose service.
DESKTOP_PROFILE=icewm
DESKTOP_RESOLUTION=1440x900x24
# slim = IceWM only (~40% smaller image). full = XFCE as well.
DESKTOP_PROFILE_BUILD=slim
BOT_DESKTOP_STREAM_HOST_PORT=6901
BOT_DESKTOP_CONTROL_HOST_PORT=7910


# -----------------------------------------------------------------------------
# Push notifications (mobile approvals)
# -----------------------------------------------------------------------------
# Backs POST /api/me/devices. Device tokens are stored either way; with push
# disabled nothing is delivered and approvals are pull-only in the UI.
EXPO_PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Even with EXPO_PUSH_ENABLED=true, delivery needs an EAS project id in
# apps/mobile/app.json (see the Expo section above). Without it the client
# never obtains a token to register, so nothing arrives and nothing errors.


# -----------------------------------------------------------------------------
# Governance / budgets
# -----------------------------------------------------------------------------
# Soft cap per bot per UTC day. Per-bot overrides live in bots/*.yaml and in
# PATCH /api/bots/{id}/budget.
DEFAULT_BOT_DAILY_BUDGET_USD=5.00

# Where the seed loader reads bot definitions from. Compose sets /bots.
BOTS_DIR=../../bots


# -----------------------------------------------------------------------------
# Azure platform (production only)
# -----------------------------------------------------------------------------
# [optional locally] With a URL set the API resolves connector secrets from Key
# Vault using its managed identity instead of env vars.
AZURE_KEY_VAULT_URL=
# [optional] Set by infra/azure/main.bicep output; enables App Insights export.
APPLICATIONINSIGHTS_CONNECTION_STRING=


# -----------------------------------------------------------------------------
# [compose] Image tags
# -----------------------------------------------------------------------------
# Locally these are built from source. docker-compose.prod.yml requires them to
# be real, pinned registry tags (never :latest).
API_IMAGE=nesqbot/api:local
WORKER_IMAGE=nesqbot/worker:local
