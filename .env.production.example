# =============================================================================
# Nesq Bot - production template. PLACEHOLDERS ONLY, NO REAL SECRETS.
# =============================================================================
# This file is committed. Never paste a real value into it.
#
# Two supported production shapes:
#
#   A) Azure (preferred) - infra/azure/main.bicep provisions everything and
#      wires most of these as Container App env vars / secret refs. Deploy the
#      Bicep first, then map its outputs onto the names below.
#
#   B) Single host - copy to .env on the box and run
#        docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#      The prod overlay hard-fails on startup if any `${VAR:?...}` is missing,
#      which is the point: no accidental dev defaults in production.
#
# Secret handling: put every CHANGE_ME below in Key Vault and inject at deploy
# time (Container App secret ref, or `az keyvault secret show` into the shell).
# Rotate JWT_SECRET, WORKER_API_TOKEN, NESQ_SIDECAR_TOKEN and VNC_PW on a
# schedule; all four are pure shared secrets with no external dependency.
# =============================================================================


# -----------------------------------------------------------------------------
# Core - REQUIRED
# -----------------------------------------------------------------------------
NESQ_ENV=production
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# REQUIRED. 48+ random bytes. Rotating this invalidates every issued token.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_JWT_SECRET

# REQUIRED. Exact origins only - no wildcards, no http:// in production.
# Native iOS/Android builds are exempt from CORS; these cover Expo web and the
# packaged desktop app's origin.
CORS_ORIGINS=https://app.nesqualtech.com,https://mobile.nesqualtech.com

# Do not put a buffering reverse proxy in front of the API. The chat endpoints
# are SSE (`text/event-stream`); nginx needs `proxy_buffering off;` and
# Azure Front Door needs response buffering disabled, or tokens arrive in one
# lump at the end of the turn instead of streaming.


# -----------------------------------------------------------------------------
# Data stores - REQUIRED
# -----------------------------------------------------------------------------
# Azure Postgres Flexible Server. sslmode is mandatory.
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/nesqbot?ssl=require
DATABASE_URL=postgresql+asyncpg://pgadmin:CHANGE_ME_PG_PASSWORD@nesqbot-pg.postgres.database.azure.com:5432/nesqbot?ssl=require

# Redis. Two Azure products are retired here: Microsoft.Cache/redis (Azure
# Cache for Redis) and the Enterprise_E*/EnterpriseFlash_F* families on
# Microsoft.Cache/redisEnterprise. Both refuse new creations. Azure Managed
# Redis - the Balanced_B*/MemoryOptimized_M* families on that same resource
# type - is the survivor and IS available in swedencentral from ~USD 55/month.
#
# main.bicep still runs Redis as a Container App on the lean tier, on internal
# TCP ingress, the same pattern as Temporal: ~USD 6-20/month for a component
# that stores nothing. sizingTier='full' swaps in Managed Redis Balanced_B1
# with HA instead.
#
# No password and no TLS: the endpoint resolves nowhere outside the Container
# Apps environment. Read the real value back with:
#   az deployment group show -g <rg> -n main \
#     --query properties.outputs.redisUrlTemplate.value -o tsv
#
# Used only for SSE pub/sub fanout in app/services/events.py, which falls back
# to an in-process queue. NOTHING DURABLE MAY LIVE HERE - there is no volume,
# no RDB and no AOF, so a restart loses the lot.
REDIS_URL=redis://nesqbot-redis.internal.CHANGE_ME.swedencentral.azurecontainerapps.io:6379/0

# On sizingTier='full' the URL is instead
# rediss://:<access-key>@<name>.swedencentral.redisenterprise.cache.azure.net:10000/0
# with the key held in Key Vault as `redis-url`.

# Only for shape (B), the self-hosted compose stack. Ignored on Azure.
POSTGRES_USER=nesq
POSTGRES_PASSWORD=CHANGE_ME_PG_PASSWORD
POSTGRES_DB=nesqbot
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=1gb


# -----------------------------------------------------------------------------
# Temporal - REQUIRED
# -----------------------------------------------------------------------------
# Shape (A), Azure: main.bicep runs temporalio/auto-setup as a Container App
# with INTERNAL ingress on TCP 7233, against its own `temporal` and
# `temporal_visibility` databases on the same Postgres Flexible Server. There
# is no public route to it and nothing outside the Container Apps environment
# resolves the name. Workflow history therefore never leaves the tenant or the
# EU - which is the whole reason for not using Temporal Cloud.
#
# The Bicep sets this env var on the API and worker itself. Read the value back
# with:
#   az deployment group show -g <rg> -n main \
#     --query properties.outputs.temporalEndpointOut.value -o tsv
TEMPORAL_HOST=nesqbot-temporal.internal.CHANGE_ME.swedencentral.azurecontainerapps.io:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nesq-bot

# Shape (B), the compose stack on one host: temporal:7233.
#
# Only set these two if you switch to Temporal Cloud instead. The self-hosted
# server above speaks plaintext gRPC over the VNet; there is no client cert.
# TEMPORAL_TLS_CERT_PATH=/secrets/temporal/client.pem
# TEMPORAL_TLS_KEY_PATH=/secrets/temporal/client.key

TEMPORAL_CONNECT_TIMEOUT_SECONDS=10
TEMPORAL_RPC_TIMEOUT_SECONDS=30
TEMPORAL_RETENTION=720h

# The API and worker both treat an unreachable Temporal as degraded rather than
# fatal, so neither waits on it at startup. /api/health/deep does report it.


# -----------------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
SIDECAR_TIMEOUT_SECONDS=30
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Retrieval - EMBEDDING_DIM must match the vector(N) columns in the database.
EMBEDDING_DIM=1536
RAG_MAX_CANDIDATES=200

# Entra id_token validation.
ENTRA_JWKS_CACHE_SECONDS=3600
ENTRA_ALLOWED_ALGORITHMS=RS256

WORKER_IDENTITY=
WORKER_HTTP_TIMEOUT_SECONDS=60
WORKER_HTTP_CONNECT_TIMEOUT_SECONDS=10
WORKER_DESKTOP_READY_TIMEOUT_SECONDS=300
WORKER_DESKTOP_POLL_INTERVAL_SECONDS=3
WORKER_APPROVAL_TIMEOUT_SECONDS=86400
WORKER_APPROVAL_POLL_INTERVAL_SECONDS=10
WORKER_STEP_TIMEOUT_SECONDS=900
WORKER_MESSAGE_TIMEOUT_SECONDS=300
WORKER_MAX_CONCURRENT_ACTIVITIES=20
WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=40
WORKER_GRACEFUL_SHUTDOWN_SECONDS=20
WORKER_CONNECT_MAX_ATTEMPTS=0
WORKER_CONNECT_INITIAL_BACKOFF_SECONDS=1
WORKER_CONNECT_MAX_BACKOFF_SECONDS=30
WORKER_RECONCILE_SCHEDULES=true
WORKER_HEALTH_FILE=/app/run/worker.health
WORKER_HEALTH_INTERVAL_SECONDS=15
WORKER_HEALTH_MAX_AGE_SECONDS=90


# -----------------------------------------------------------------------------
# Worker -> API authentication - REQUIRED
# -----------------------------------------------------------------------------
# On Azure this is the API Container App's internal FQDN.
API_INTERNAL_URL=https://nesqbot-api.internal.CHANGE_ME.azurecontainerapps.io
# MUST be false in production. The API refuses X-Nesq-Dev when NESQ_ENV=production.
API_DEV_HEADER=false
# REQUIRED. Service token: python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_API_TOKEN=CHANGE_ME_WORKER_API_TOKEN


# -----------------------------------------------------------------------------
# Microsoft Entra ID - REQUIRED
# -----------------------------------------------------------------------------
# Without these the API has no way to authenticate a human, and dev-login is
# disabled in production.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Prefer federated credentials / managed identity over a client secret.
AZURE_CLIENT_SECRET=CHANGE_ME_OR_USE_MANAGED_IDENTITY

# The user-assigned managed identity the API authenticates to ARM with, for
# the ACI desktop driver and Key Vault. Kept separate from AZURE_CLIENT_ID on
# purpose: once the Entra app registration exists, AZURE_CLIENT_ID becomes the
# app id, and pointing ManagedIdentityCredential at an app id fails at IMDS.
AZURE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client-side copies, inlined into the desktop and mobile bundles at build
# time. EXPO_PUBLIC_* is public by definition - never a secret.
EXPO_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_API_BASE_URL=https://api.nesqualtech.com

# The app registration is a manual, one-time step - Bicep cannot create it,
# because app registrations are Microsoft Graph objects, not ARM resources.
# Platform: "Mobile and desktop applications". Redirect URI: nesqbot://auth.
# ID tokens must be enabled. Full walkthrough in .env.example and
# infra/azure/README.md.


# -----------------------------------------------------------------------------
# Azure AI Foundry - REQUIRED
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://nesqbot-aoai.openai.azure.com/
# Leave BLANK when the Container App's user-assigned identity holds the
# "Cognitive Services OpenAI User" role - the Bicep assigns exactly that.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Deployment names, not model names. These four must match the deployments
# infra/azure/main.bicep creates AND the defaults in apps/api/app/config.py;
# all three were verified present in swedencentral as GlobalStandard with
#   az cognitiveservices model list -l swedencentral
# Tier mapping (see the comment block in config.py for prices):
#   NANO   gpt-5.6-luna  2026-07-09  classify, route, compact - most calls
#   MINI   gpt-5.4-mini  2026-03-17  agent turns and tool calling
#   REASON gpt-5.6-sol   2026-07-09  rare escalations only
AZURE_DEPLOYMENT_NANO=gpt-5.6-luna
AZURE_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_DEPLOYMENT_REASON=gpt-5.6-sol
AZURE_DEPLOYMENT_EMBED=text-embedding-3-small


# -----------------------------------------------------------------------------
# What a desktop agent step costs - OPTIONAL, defaults are the shipped ones
# -----------------------------------------------------------------------------
# A desktop agent is priced in *images*: one screenshot is roughly a thousand
# prompt tokens. A real 35-step run spent an entire $5.00 daily budget in one
# turn, almost all of it on re-sending frames the model had already acted on.
# Leave these unset unless you are deliberately re-tuning that trade.
#
# They apply to the agent loop only. GET /bots/{id}/desktop/screenshot still
# serves a full-size PNG for a human looking at their bot's screen.

# jpeg | png, and the capture options that go with it. JPEG q70 at 1024px wide
# is 765 prompt tokens against 1105 for a full 1280x800 PNG; the larger win is
# bytes, since a full-screen PNG is ~1.5 MB of base64 every step.
AGENT_SCREENSHOT_FORMAT=jpeg
AGENT_SCREENSHOT_QUALITY=70
# Rescaling changes the coordinate space the model clicks in.
# desktop.ScreenGeometry maps every point back onto true desktop pixels before
# the sidecar sees it; do not change this without reading that class.
AGENT_SCREENSHOT_MAX_WIDTH=1024
AGENT_SCREENSHOT_GRAYSCALE=false
# Screenshots kept in the live conversation as images; older ones become a
# one-line placeholder. The biggest cost lever in the product - without it the
# bill grows with the square of the step count (a 35-step run re-sent 630
# images). Raising it above 2 re-introduces that curve.
AGENT_SCREENSHOT_HISTORY=2

# reasoning_effort per class of call; empty means send none. Ordinary steps run
# on the reason tier, which accepts only "" or "none" alongside function tools;
# the opening call runs on mini, which takes the full graded scale.
AGENT_EFFORT_STEP=none
AGENT_EFFORT_OPENING=low
AGENT_EFFORT_RECOVER=

# Defaults for a bare browser_snapshot. The DOM lane buys reliability, not
# bytes: an unbounded 200-element snapshot (~3 000 text tokens) costs more than
# the 1024px screenshot it replaces (~1 300 vision tokens), so the default is
# what is on screen, capped. The model overrides any of these per call.
AGENT_BROWSER_SNAPSHOT_MAX_ELEMENTS=100
AGENT_BROWSER_SNAPSHOT_VIEWPORT_ONLY=true
AGENT_BROWSER_SNAPSHOT_MAX_TEXT=20


# -----------------------------------------------------------------------------
# Bot Desktop - REQUIRED
# -----------------------------------------------------------------------------
# aci on Azure: one container group per bot, hypervisor-isolated, billed per
# second, no cluster floor. Never `docker` in production - that needs a host
# socket mount, which is a container escape with extra steps.
BOT_DESKTOP_MODE=aci
# v0.2.0 is the floor, not a preference. The browser_* agent tools drive the
# desktop's Chromium over the sidecar's /browser/* CDP surface, which does not
# exist on v0.1.x: against an older image every DOM call answers
# 503 browser_unavailable and the agent degrades to clicking pixel coordinates -
# safe, and measurably worse (~92% task reliability for DOM-driven browser
# agents against 75-78% for vision-driven).
# main.bicep sets this env var from botDesktopImageTag, so change it there
# rather than here for a deployed environment.
BOT_DESKTOP_IMAGE=CHANGE_ME.azurecr.io/nesqbot/bot-desktop:v0.2.0
BOT_DESKTOP_NETWORK=
# Azure Files share mounted into the API; desktops get their own volume.
BOT_DESKTOP_HOME_ROOT=/mnt/bot-homes
# Desktops have private IPs only, so there is no shared stream hostname. Leave
# empty and let the driver address each container group by its subnet address.
BOT_DESKTOP_STREAM_BASE=


# -----------------------------------------------------------------------------
# Azure Container Instances - REQUIRED when BOT_DESKTOP_MODE=aci
# -----------------------------------------------------------------------------
# Every one of these is a main.bicep output. After deploying:
#   az deployment group show -g <rg> -n main --query properties.outputs
#
# None of them is a secret: the desktop driver authenticates as the API's
# user-assigned managed identity, which holds exactly three grants -
# "Azure Container Instances Contributor Role" on the resource group, a custom
# subnet-join role on the desktop subnet, and "Managed Identity Operator" on
# itself so it can attach that identity to the container groups it creates.
ACI_RESOURCE_GROUP=rg-nesqbot
ACI_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ACI_REGION=swedencentral
# Delegated to Microsoft.ContainerInstance/containerGroups. Container groups
# injected here get a private IP and no public endpoint.
ACI_SUBNET_ID=/subscriptions/CHANGE_ME/resourceGroups/rg-nesqbot/providers/Microsoft.Network/virtualNetworks/nesqbot-vnet/subnets/snet-bot-desktops
ACI_CPU=2.0
ACI_MEMORY_GB=4.0
# ACR pulls use this user-assigned identity's AcrPull grant. Never the admin
# user - main.bicep leaves adminUserEnabled false precisely so it cannot be.
ACI_REGISTRY_SERVER=CHANGE_ME.azurecr.io
# The identity's FULL ARM RESOURCE ID, not its client id: the ACI SDK keys both
# user_assigned_identities and ImageRegistryCredential.identity by resource id.
ACI_REGISTRY_IDENTITY=/subscriptions/CHANGE_ME/resourceGroups/rg-nesqbot/providers/Microsoft.ManagedIdentity/userAssignedIdentities/nesqbot-id
# Cold pull of the desktop image into a fresh container group. The subnet has a
# NAT gateway; without one the pull would hang here rather than fail, because a
# delegated ACI subnet has had no default outbound internet since 2025-09-30.
ACI_START_TIMEOUT_SECONDS=180

# Azure Files mount for bot homes. Not optional: with no volume, every stop
# destroys the bot's home directory - browser profile, cookies and logged-in
# sessions with it - and a bot that has to sign in again every morning is not
# the product. Same share the API mounts at BOT_DESKTOP_HOME_ROOT.
ACI_FILES_ACCOUNT=CHANGE_ME_STORAGE_ACCOUNT
ACI_FILES_SHARE=bot-homes
# ACI has no identity-based option for SMB volumes, so the mount needs the
# storage account key. It lives in Key Vault under this name - read it with the
# managed identity from AZURE_KEY_VAULT_URL. Never inline the key here.
ACI_FILES_KEY_SECRET_NAME=storage-account-key

# REQUIRED. Anything on the pod network can drive the desktop without it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Stored as the `sidecar-token` key of the nesq-desktop-secrets Secret - see
# infra/bot-desktop/k8s/desktop-template.yaml.
NESQ_SIDECAR_TOKEN=CHANGE_ME_SIDECAR_TOKEN
# REQUIRED. Same Secret, `vnc-password` key.
VNC_PW=CHANGE_ME_VNC_PASSWORD
DESKTOP_PROFILE=icewm
DESKTOP_RESOLUTION=1440x900x24


# -----------------------------------------------------------------------------
# Push notifications - optional
# -----------------------------------------------------------------------------
EXPO_PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# REQUIRED for push to work at all. Without an EAS project id in
# apps/mobile/app.json (`expo.extra.eas.projectId`), getExpoPushTokenAsync
# returns nothing, POST /api/me/devices never receives a token, and approval
# notifications fail silently. Run `npx eas init` in apps/mobile once.
EAS_PROJECT_ID=CHANGE_ME_EAS_PROJECT_ID


# -----------------------------------------------------------------------------
# Governance
# -----------------------------------------------------------------------------
DEFAULT_BOT_DAILY_BUDGET_USD=5.00
BOTS_DIR=/bots


# -----------------------------------------------------------------------------
# Azure platform - REQUIRED
# -----------------------------------------------------------------------------
AZURE_KEY_VAULT_URL=https://CHANGE_ME.vault.azure.net/
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=CHANGE_ME;IngestionEndpoint=https://swedencentral-0.in.applicationinsights.azure.com/


# -----------------------------------------------------------------------------
# Image tags - REQUIRED, pinned, never :latest
# -----------------------------------------------------------------------------
API_IMAGE=CHANGE_ME.azurecr.io/nesqbot/api:v0.1.0
WORKER_IMAGE=CHANGE_ME.azurecr.io/nesqbot/worker:v0.1.0
