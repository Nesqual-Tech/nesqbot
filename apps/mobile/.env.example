# Base URL of the Nesq Bot API, including the /api prefix.
#
# LEAVE THIS UNSET for a normal build. app.config.ts defaults to the PRODUCTION
# API — the same origin apps/desktop/.env.production points at — so a build can
# never accidentally ship pointing at a developer machine.
#
# Set it only to aim a build somewhere else. A phone cannot reach "localhost";
# use your machine's LAN IP. The iOS Simulator is the one exception — it shares
# the host's loopback, so localhost works there.
#
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api   # physical device -> LAN
#   EXPO_PUBLIC_API_URL=http://localhost:8080/api      # iOS Simulator only
#
# The Settings screen also has a runtime override, which beats both.

# Microsoft Entra sign-in (auth code + PKCE). Defaults for these live in
# app.json under `extra.entra`; set them here only to point a build at a
# different tenant or registration.
#
# Every value is PUBLIC — it is compiled into the shipped bundle. There is no
# client secret and there must never be one: a secret in a mobile binary is not
# a secret. See docs/entra-setup.md.
EXPO_PUBLIC_ENTRA_TENANT_ID=YOUR_TENANT_ID
# The public client app id (`Nesq Bot`) — NOT the API's app id.
EXPO_PUBLIC_ENTRA_CLIENT_ID=YOUR_CLIENT_APP_ID
# The scope on the API resource server (`Nesq Bot API`), full URI form.
EXPO_PUBLIC_ENTRA_SCOPE=api://YOUR_API_APP_ID/access_as_user
EXPO_PUBLIC_ENTRA_REDIRECT_URI=nesqbot://auth
