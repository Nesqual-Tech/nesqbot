# Workspace packages (@nesqbot/*) must be symlinked into node_modules, not
# copied: apps/desktop (Vite) and apps/mobile (Metro) compile their TypeScript
# source directly, and a copy would freeze at install time.
#
# Per npm's own config definition, install-links only affects `file:` protocol
# specifiers and "has no effect on workspaces" — so workspace deps declared as
# "@nesqbot/ui": "*" symlink either way. It is pinned to false anyway because
# a `file:../../packages/x` specifier is an easy thing for someone to reach
# for, and under install-links=true that one would silently be copied.
install-links=false

# The repo requires Node >= 20. Fail at install time, not at a confusing
# runtime error three commands later.
engine-strict=true

fund=false
audit=false
